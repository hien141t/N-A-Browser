<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <title>i9 Auto Register</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      background-color: #0b0f19;
      color: #f3f4f6;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      margin: 0;
      padding: 14px;
      width: 400px;
      box-sizing: border-box;
    }

    * {
      box-sizing: border-box;
    }

    .header {
      text-align: center;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid #1e293b;
    }

    .header h1 {
      font-size: 18px;
      margin: 0 0 4px 0;
      background: linear-gradient(135deg, #00f2fe 0%, #4facfe 50%, #00c6ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
      letter-spacing: 1.2px;
      font-weight: 800;
    }

    .header .subtitle {
      font-size: 11px;
      color: #64748b;
      font-weight: 500;
    }

    .api-key-box {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 12px;
      background: #111827;
      border: 1px solid #1f293d;
      border-radius: 8px;
      padding: 8px 10px;
    }

    .api-key-box input {
      flex: 1;
      background: transparent;
      border: none;
      color: #f3f4f6;
      font-size: 11px;
      outline: none;
      font-family: 'Inter', monospace;
    }

    .api-key-box input::placeholder {
      color: #4b5563;
    }

    .btn-toggle-key {
      background: none;
      border: none;
      color: #94a3b8;
      cursor: pointer;
      font-size: 13px;
      padding: 0 4px;
      transition: color 0.2s;
    }

    .btn-toggle-key:hover {
      color: #38bdf8;
    }

    .api-key-status {
      font-size: 10px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 12px;
      background: #1e293b;
      color: #94a3b8;
      white-space: nowrap;
    }

    .api-key-status.ok {
      background: rgba(34, 197, 94, 0.15);
      color: #4ade80;
    }

    .api-key-status.err {
      background: rgba(239, 68, 68, 0.15);
      color: #f87171;
    }

    .btn-save-key {
      background: #2563eb;
      border: none;
      color: white;
      font-size: 11px;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 6px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.2s;
    }

    .btn-save-key:hover {
      background: #1d4ed8;
    }

    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 14px;
    }

    .btn-action {
      font-weight: 700;
      font-size: 11px;
      border: none;
      border-radius: 8px;
      padding: 10px 6px;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn-random {
      background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    .btn-random:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(139, 92, 246, 0.45);
    }

    .btn-run-all {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
    }

    .btn-run-all:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(245, 158, 11, 0.45);
    }

    .btn-green {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
    }

    .btn-green:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.45);
    }

    .btn-pink {
      background: linear-gradient(135deg, #ec4899 0%, #be185d 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(236, 72, 153, 0.3);
    }

    .btn-pink:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(236, 72, 153, 0.45);
    }

    .card {
      background-color: #111827;
      border: 1px solid #1f293d;
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 12px;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .card-title {
      color: #38bdf8;
      font-size: 12px;
      font-weight: 700;
      margin-top: 0;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 6px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .input-group {
      margin-bottom: 9px;
    }

    .input-group label {
      display: block;
      font-size: 10.5px;
      color: #94a3b8;
      margin-bottom: 3px;
      font-weight: 600;
    }

    .input-group input,
    .input-group select {
      width: 100%;
      background-color: #0b0f19;
      border: 1px solid #1f293d;
      border-radius: 6px;
      color: #f3f4f6;
      padding: 7px 9px;
      font-size: 11.5px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .input-group input:focus,
    .input-group select:focus {
      border-color: #38bdf8;
      box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
    }

    .input-row {
      display: flex;
      gap: 5px;
      width: 100%;
    }

    .input-row input,
    .input-row select {
      flex: 1;
      min-width: 0;
    }

    .btn-input-random {
      background: #1e293b;
      color: #cbd5e1;
      border: 1px solid #334155;
      border-radius: 6px;
      padding: 0 9px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: all 0.2s ease;
    }

    .btn-input-random:hover {
      background: #3b82f6;
      border-color: #3b82f6;
      color: white;
      box-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 9px;
    }

    .grid-col-span-2 {
      grid-column: span 2;
    }

    .log-box {
      background: #070a12;
      border: 1px solid #1f293d;
      border-radius: 6px;
      padding: 8px 10px;
      max-height: 110px;
      overflow-y: auto;
      font-size: 10px;
      color: #94a3b8;
      margin-top: 10px;
      font-family: 'Consolas', 'Courier New', monospace;
    }

    .log-box .log-entry {
      margin-bottom: 3px;
      line-height: 1.35;
    }

    .log-box .log-success { color: #4ade80; }
    .log-box .log-error { color: #f87171; }
    .log-box .log-info { color: #38bdf8; }
  </style>
</head>

<body>
  <div class="header">
    <h1>🎰 TOOL REG i9 AUTO</h1>
    <div class="subtitle">Tự động đăng ký & Giải Captcha i9 (9922999, 9922044)</div>
  </div>

  <!-- API Key Box -->
  <div class="api-key-box">
    <span style="font-size:15px">🔑</span>
    <input type="password" id="apiKeyInput" placeholder="Nhập API Key VPS OCR..." />
    <button type="button" id="toggleApiKeyBtn" class="btn-toggle-key" title="Xem/Ẩn Key">👁️</button>
    <span class="api-key-status" id="apiKeyStatus">Chưa có key</span>
    <button class="btn-save-key" id="saveApiKeyBtn">Lưu</button>
  </div>

  <!-- Action Grid -->
  <div class="action-grid" style="grid-template-columns: 1fr 1fr;">
    <button id="randomAllBtn" class="btn-action btn-random">🎲 Random Data</button>
    <button id="runAllBtn" class="btn-action btn-run-all">⚡ CHẠY ALL</button>
    <button id="fillBtn" class="btn-action btn-green">🚀 ĐĂNG KÝ</button>
    <button id="moneyPassBtn" class="btn-action btn-pink">💳 LIÊN KẾT NH</button>
    <button id="promoBtn" class="btn-action grid-col-span-2" style="background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white;" title="Xin Khuyến Mãi tại i9sanh.cc">🎁 XIN KHUYẾN MÃI (50k)</button>
  </div>

  <!-- Card: Thông tin Đăng Ký -->
  <div class="card">
    <div class="card-title">📝 Thông Tin Đăng Ký i9</div>

    <div class="form-grid">
      <!-- Select Website -->
      <div class="input-group grid-col-span-2">
        <label>Website đăng ký i9:</label>
        <div class="input-row" style="margin-bottom: 5px;">
          <select id="siteSelect" style="flex: 1;"></select>
          <button id="deleteSiteBtn" class="btn-input-random" title="Xóa link đang chọn"
            style="background: #ef4444; border-color: #dc2626; color: white;">🗑️</button>
        </div>
        <div class="input-row">
          <input type="text" id="newSiteInput" placeholder="Thêm URL website mới (VD: https://m.9922999.com/Account/Register)..."
            style="flex: 1; font-size: 10.5px;">
          <button id="addSiteBtn" class="btn-input-random" title="Thêm website"
            style="background: #10b981; border-color: #059669; color: white;">➕</button>
        </div>
      </div>

      <div class="input-group">
        <label for="username">Tên tài khoản:</label>
        <div class="input-row">
          <input type="text" id="username" placeholder="Tên tài khoản...">
          <button id="randomUserBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <div class="input-group">
        <label for="password">Mật khẩu:</label>
        <div class="input-row">
          <input type="text" id="password" placeholder="Mật khẩu...">
          <button id="randomPassBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <div class="input-group">
        <label for="confirmPassword">Nhập lại mật khẩu:</label>
        <div class="input-row">
          <input type="text" id="confirmPassword" placeholder="Nhập lại mật khẩu..." readonly style="background:#161f30; cursor:not-allowed;">
        </div>
      </div>

      <div class="input-group">
        <label for="fullname">Họ và tên (Chủ khoản):</label>
        <div class="input-row">
          <input type="text" id="fullname" placeholder="Họ và tên chủ khoản...">
          <button id="randomNameBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <div class="input-group">
        <label for="phone">Số điện thoại:</label>
        <div class="input-row">
          <input type="text" id="phone" placeholder="Số điện thoại...">
          <button id="randomPhoneBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <div class="input-group">
        <label for="withdrawPass">Mật khẩu rút tiền:</label>
        <div class="input-row">
          <input type="text" id="withdrawPass" placeholder="MK rút tiền...">
          <button id="randomWithdrawBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <div class="input-group">
        <label for="bankName">Ngân hàng:</label>
        <div class="input-row">
          <input type="text" id="bankName" list="bankList" placeholder="Tìm & chọn NH..."
            style="width: 100%; padding: 7px; border-radius: 6px; background: #0b0f19; color: #fff; border: 1px solid #1f293d;">
          <datalist id="bankList">
            <option value="VIETCOMBANK"></option>
            <option value="VIETINBANK"></option>
            <option value="BIDV"></option>
            <option value="TECHCOMBANK"></option>
            <option value="MBBANK"></option>
            <option value="ACB"></option>
            <option value="VPBANK"></option>
            <option value="TPBANK"></option>
            <option value="SACOMBANK"></option>
            <option value="VIB BANK"></option>
            <option value="SHB BANK"></option>
            <option value="MSB BANK"></option>
            <option value="OCB BANK"></option>
            <option value="EXIMBANK"></option>
            <option value="HDBANK"></option>
            <option value="LIENVIET BANK"></option>
            <option value="SEABANK"></option>
            <option value="AGRIBANK"></option>
            <option value="KIENLONGBANK"></option>
            <option value="BAC A BANK"></option>
          </datalist>
        </div>
      </div>

      <div class="input-group">
        <label for="bankBranch">Chi nhánh NH:</label>
        <div class="input-row">
          <input type="text" id="bankBranch" placeholder="Chi nhánh...">
          <button id="randomBranchBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <div class="input-group grid-col-span-2">
        <label for="bankAccount">Số tài khoản (STK):</label>
        <div class="input-row">
          <input type="text" id="bankAccount" placeholder="Số tài khoản ngân hàng...">
          <button id="randomAccountBtn" class="btn-input-random" title="Ngẫu nhiên">🎲</button>
        </div>
      </div>

      <!-- Cấu hình Xin Khuyến Mãi -->
      <div class="input-group grid-col-span-2" style="border-top: 1px dashed #1f293d; padding-top: 8px; margin-top: 4px;">
        <label style="color:#38bdf8;">🎁 URL Xin Khuyến Mãi & Nạp Tiền (Nạp mặc định: 50):</label>
        <div class="input-row" style="margin-bottom: 4px;">
          <input type="text" id="promoUrl" value="https://i9sanh.cc/Activity/detail/id/111" placeholder="URL trang Xin Khuyến Mãi..." style="flex: 1; font-size: 10.5px;">
        </div>
        <div class="input-row">
          <input type="text" id="depositAmount" value="50" placeholder="Tổng tiền nạp (VD: 50)..." style="flex: 1; font-size: 10.5px;">
        </div>
      </div>
    </div>

    <!-- Logs Window -->
    <div class="log-box" id="logBox">
      <div class="log-entry log-info">[Hệ thống] Tool i9 Auto Register sẵn sàng.</div>
    </div>
  </div>

  <!-- Card: Tài Khoản Đã Đăng Ký (Tự Động Lưu) -->
  <div class="card">
    <div class="card-title" style="justify-content: space-between; align-items: center;">
      <span>💾 TK Đã Đăng Ký (<span id="savedAccCount">0</span>)</span>
      <div style="display: flex; gap: 4px;">
        <button id="copyAllAccBtn" class="btn-save-key" style="background:#10b981; padding:3px 7px; font-size:10px;" title="Sao chép toàn bộ danh sách">📋 Copy</button>
        <button id="exportTxtBtn" class="btn-save-key" style="background:#3b82f6; padding:3px 7px; font-size:10px;" title="Tải file TXT">📥 TXT</button>
        <button id="clearAccBtn" class="btn-save-key" style="background:#ef4444; padding:3px 7px; font-size:10px;" title="Xóa lịch sử">🗑️ Xóa</button>
      </div>
    </div>

    <div id="savedAccList" style="max-height: 140px; overflow-y: auto; font-size: 10.5px; font-family: monospace; background: #070a12; border: 1px solid #1f293d; border-radius: 6px; padding: 6px;">
      <div style="color: #64748b; text-align: center; padding: 8px;">Chưa có tài khoản nào được lưu.</div>
    </div>
  </div>

  <script src="popup.js"></script>
</body>

</html>

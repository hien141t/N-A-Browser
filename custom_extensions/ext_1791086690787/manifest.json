{
  "manifest_version": 3,
  "name": "58WWIN Automation Tool",
  "version": "1.0",
  "description": "Tự động đăng ký và cài đặt bảo mật cho 58WWIN",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "action": { "default_popup": "popup.html" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cloudfront.net/*",
        "*://*.58w.win/*",
        "*://*.58win.com/*",
        "*://*.58win.net/*",
        "*://*.58wwin.com/*",
        "*://*.c1688.net/*",
        "*://*.c168u.com/*",
        "*://*.c168r.com/*",
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": ["captcha.js", "content.js"]
    }
  ],
  "host_permissions": [
    "*://*.cloudfront.net/*",
    "*://*.58w.win/*",
    "*://*.58win.com/*",
    "*://*.58win.net/*",
    "*://*.58wwin.com/*",
    "*://*.c1688.net/*",
    "*://*.c168u.com/*",
    "*://*.c168r.com/*",
    "https://api.telegram.org/*",
    "http://localhost:5888/*",
    "<all_urls>"
  ]
}

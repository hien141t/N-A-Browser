{
  "manifest_version": 3,
  "name": "Tool i9 Auto Register",
  "version": "1.0",
  "description": "Tự động đăng ký, điền form i9 (9922999.com, 9922044.com), giải captcha OCR qua ddddocr server",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.9922999.com/*",
    "*://*.9922044.com/*",
    "*://*.9922*.com/*",
    "http://180.93.106.208:5588/*",
    "http://127.0.0.1:5588/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.9922999.com/*",
        "*://*.9922044.com/*",
        "*://*.9922*.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
